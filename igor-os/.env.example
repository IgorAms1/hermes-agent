# Igor OS environment template.
# Copy to ~/.hermes/.env and fill in real values. Do not commit real secrets.

# OpenRouter
OPENROUTER_API_KEY=

# Optional runtime override for the default model.
# Change this to any OpenRouter model slug.
# Recommended default: strong, long-context, good for agentic work.
HERMES_INFERENCE_MODEL=anthropic/claude-opus-4.6
HERMES_INFERENCE_PROVIDER=openrouter

# Telegram
# Get this from @BotFather.
TELEGRAM_BOT_TOKEN=

# Required. Comma-separated numeric Telegram user IDs allowed to use the bot.
TELEGRAM_ALLOWED_USERS=

# Optional. Set via /sethome in Telegram or paste your private chat ID here.
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=Igor

# Keep this false. Igor OS is a private personal agent.
GATEWAY_ALLOW_ALL_USERS=false

# Optional: where Telegram-triggered terminal/file work should run.
# Set this to the absolute path of this igor-os directory after cloning.
# MESSAGING_CWD=/absolute/path/to/hermes-agent/igor-os

# Optional: choose local backend for macOS/VPS simplicity.
TERMINAL_ENV=local
TERMINAL_TIMEOUT=180

# Optional: webhook mode for production. Long polling is simpler and recommended first.
# TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_PORT=8443
# TELEGRAM_WEBHOOK_SECRET=
